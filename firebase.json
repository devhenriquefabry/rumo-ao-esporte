{
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "/sw.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    },
                    {
                        "key": "Service-Worker-Allowed",
                        "value": "/"
                    }
                ]
            },
            {
                "source": "/manifest.webmanifest",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/manifest+json"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, max-age=0, must-revalidate"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
