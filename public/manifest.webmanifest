{
  "id": "/aluno/",
  "name": "Rumo ao Esporte",
  "short_name": "Rumo Esporte",
  "description": "Portal do aluno para pagamentos, carteirinha e informações do Rumo ao Esporte.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/aluno/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f4f8fc",
  "theme_color": "#17428f",
  "categories": [
    "sports",
    "finance"
  ],
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pagamentos",
      "short_name": "Pagamentos",
      "description": "Abrir minhas faturas e pagamentos",
      "url": "/aluno/financeiro?source=pwa-shortcut",
      "icons": [
        {
          "src": "/pwa/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Carteirinha",
      "short_name": "Carteirinha",
      "description": "Abrir minha carteirinha digital",
      "url": "/aluno/carteirinha?source=pwa-shortcut",
      "icons": [
        {
          "src": "/pwa/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
